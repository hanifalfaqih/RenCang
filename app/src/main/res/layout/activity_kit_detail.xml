<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".KitDetailActivity">

    <ImageView
        android:id="@+id/iv_header_image"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:scaleType="centerCrop"
        android:src="@android:color/darker_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Header image for the kit" />

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/button_background_circle"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Back button"
        app:tint="@android:color/white"/>

    <LinearLayout
        android:id="@+id/ll_details"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/iv_header_image"
        app:layout_constraintBottom_toTopOf="@id/btn_start_journey"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="top">

        <TextView
            android:id="@+id/tv_kit_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speedy Kangkung Kit"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/tv_harvest_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready to harvest in 21 days"
            android:textSize="16sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tv_shopping_list_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shopping List"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginTop="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pot (25cm diameter)"
                android:drawableLeft="@drawable/ic_checkmark"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Organic Potting Soil (2kg)"
                android:drawableLeft="@drawable/ic_checkmark"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kangkung Seeds (15g)"
                android:drawableLeft="@drawable/ic_checkmark"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Basic Fertilizer (100g)"
                android:drawableLeft="@drawable/ic_checkmark"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:textSize="16sp"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Water Spray Bottle"
                android:drawableLeft="@drawable/ic_checkmark"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:textSize="16sp"/>
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_start_journey"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Start This Journey"
        android:padding="16dp"
        android:layout_margin="16dp"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="@color/dark_green"/>

</androidx.constraintlayout.widget.ConstraintLayout>
